{
  "name": "entry-wise",
  "version": "0.2.0-beta.1",
  "description": "Developer-friendly, production-grade form backend API on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "openapi:generate": "bun run scripts/export-openapi.ts",
    "vacuum:lint": "vacuum lint -r .vacuum.yaml openapi.json",
    "vacuum:report": "vacuum html-report -r .vacuum.yaml openapi.json vacuum-report.html",
    "vacuum:dashboard": "vacuum dashboard -r .vacuum.yaml openapi.json",
    "security:check": "bun run openapi:generate && bun run vacuum:lint"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.19.8",
    "@hono/zod-validator": "^0.7.0",
    "@react-email/components": "^0.0.41",
    "@react-email/render": "^1.1.2",
    "@scalar/hono-api-reference": "^0.9.3",
    "@types/react": "^19.1.6",
    "cloudinary": "^2.6.1",
    "hono": "^4.7.11",
    "hono-openapi": "^0.4.8",
    "react": "^19.1.0",
    "resend": "^4.5.2",
    "zod": "^3.25.56",
    "zod-form-data": "^3.0.0",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "^4.20250607.0",
    "@quobix/vacuum": "^0.30.6",
    "@types/node": "^26.6.2",
    "wrangler": "^4.4.0"
  },
  "trustedDependencies": [
    "@quobix/vacuum"
  ]
}
