{
  "name": "apps-web",
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "seed:generate": "bun run scripts/generate-seed.ts",
    "cms:types": "emdash types",
    "deploy": "astro build && wrangler deploy",
    "seed:validate": "emdash seed seed/seed.json --validate",
    "cms:check": "emdash doctor"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@emdash-cms/cloudflare": "^1.2.0",
    "astro": "^7.3.3",
    "emdash": "^1.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.149.0"
  }
}
