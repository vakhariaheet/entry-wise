---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  sections: { id: string; heading: string }[];
}

const { title, description, sections } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090a" />
    <title>{title} — EntryWise</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header>
      <div class="header-inner">
        <a class="brand" href="/">
          <img src="/assets/logo.png" alt="" width="24" height="24" />
          EntryWise
        </a>
        <nav aria-label="Main navigation">
          <a href="/docs">Docs</a>
          <a href="https://entrywise-app.pages.dev">Console →</a>
        </nav>
      </div>
    </header>
    <main id="content" class="legal-layout">
      <article>
        <div class="eyebrow">EntryWise / Legal</div>
        <h1>{title}</h1>
        <p class="updated">Last updated: <time datetime="2026-10-11">October 11, 2026</time></p>
        <div class="legal-prose"><slot /></div>
      </article>
      <aside>
        <nav aria-label="On this page">
          <div class="eyebrow">On this page</div>
          <ul>
            {sections.map(({ id, heading }) => <li><a href={`#${id}`}>{heading}</a></li>)}
          </ul>
        </nav>
      </aside>
    </main>
    <footer>
      <span>EntryWise</span>
      <nav aria-label="Legal navigation">
        <a href="/privacy" aria-current={Astro.url.pathname === '/privacy' ? 'page' : undefined}>Privacy Policy</a>
        <a href="/terms" aria-current={Astro.url.pathname === '/terms' ? 'page' : undefined}>Terms of Service</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  header { border-bottom: 1px solid var(--border-subtle); }
  .header-inner, footer { max-width: 1120px; margin: auto; padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; font-size: 13px; }
  a { color: var(--text-secondary); text-decoration: none; }
  a:hover, a[aria-current='page'] { color: var(--text-primary); }
  a:focus-visible { outline: 2px solid var(--text-primary); outline-offset: 5px; border-radius: 2px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--text-primary); font-size: 14px; font-weight: 600; }
  .brand img { border-radius: 4px; }
  .legal-layout { max-width: 1120px; margin: auto; padding: 64px 24px 80px; display: grid; grid-template-columns: minmax(0, 700px) 220px; gap: 72px; }
  .eyebrow { color: var(--text-secondary); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
  h1 { margin: 16px 0; font-size: clamp(32px, 5vw, 44px); line-height: 1.15; letter-spacing: -.03em; font-weight: 600; }
  .updated { margin: 0 0 40px; color: var(--text-secondary); font-size: 13px; }
  aside nav { position: sticky; top: 32px; display: block; }
  aside ul { list-style: none; margin: 16px 0 0; padding: 0 0 0 16px; border-left: 1px solid var(--border-default); }
  aside li { margin: 12px 0; line-height: 1.5; }
  .legal-prose { color: var(--text-secondary); font-size: 16px; line-height: 1.75; overflow-wrap: anywhere; }
  .legal-prose :global(h2) { margin: 40px 0 12px; color: var(--text-primary); font-size: 22px; font-weight: 500; letter-spacing: -.02em; scroll-margin-top: 24px; }
  .legal-prose :global(p) { margin: 0 0 16px; }
  .legal-prose :global(ul) { padding-left: 24px; margin: 0 0 20px; }
  .legal-prose :global(li) { margin: 8px 0; }
  .legal-prose :global(a) { color: var(--text-primary); text-decoration: underline; text-underline-offset: 3px; }
  .legal-prose :global(a:focus-visible) { outline: 2px solid var(--text-primary); outline-offset: 3px; }
  .legal-prose :global(strong) { color: var(--text-primary); font-weight: 500; }
  footer { border-top: 1px solid var(--border-subtle); color: var(--text-secondary); font-size: 13px; }
  .skip-link { position: absolute; top: -100px; left: 24px; background: var(--bg-elevated); padding: 12px; z-index: 10; }
  .skip-link:focus { top: 12px; }
  @media (max-width: 900px) {
    .legal-layout { grid-template-columns: minmax(0, 1fr); gap: 0; max-width: 748px; padding-top: 40px; }
    aside { display: none; }
  }
  @media (max-width: 480px) {
    .header-inner, footer { padding: 20px; }
    .legal-layout { padding: 36px 20px 56px; }
    footer { align-items: flex-start; flex-direction: column; gap: 16px; }
  }
</style>
