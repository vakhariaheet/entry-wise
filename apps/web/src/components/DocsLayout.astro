---
import { DOC_CATEGORIES, type DocSection } from '../data/defaultDocs';
import type { ResolvedDocArticle } from '../lib/emdashDocs';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  allDocs: ResolvedDocArticle[];
  currentSlug?: string;
  sections?: DocSection[];
  isFromCms?: boolean;
}

const {
  title,
  description,
  allDocs,
  currentSlug = '',
  sections = [],
  isFromCms = false,
} = Astro.props;

const groupedDocs = DOC_CATEGORIES.map((category) => ({
  category,
  items: allDocs.filter((doc) => doc.category === category),
})).filter((group) => group.items.length > 0);
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#08090a" />
  <title>{title} | EntryWise Documentation</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/assets/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body class="bg-[#08090a] text-[#f7f8f8] min-h-screen antialiased selection:bg-white/15 selection:text-white">
  <!-- Top Navigation Header (56px, 1px architectural hairline) -->
  <header class="h-14 border-b border-[#181a1f] bg-[#08090a]/90 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-[1380px] mx-auto px-4 sm:px-6 h-full flex items-center justify-between gap-4">
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-2.5">
          <a href="/" class="flex items-center gap-2 text-[#f7f8f8] hover:opacity-90 transition">
            <img
              src="/assets/logo.png"
              alt="EntryWise"
              class="w-5 h-5 rounded-[4px] border border-[#22252b]"
            />
            <span class="font-medium text-[13.5px] tracking-[-0.01em]">EntryWise</span>
          </a>
          <span class="text-[#32363f] font-mono text-xs select-none">/</span>
          <a
            href="/docs"
            class="text-[13px] font-medium text-[#a1a6b0] hover:text-[#f7f8f8] transition"
          >
            Docs
          </a>
        </div>

        <nav class="hidden md:flex items-center gap-5 text-[13px] text-[#a1a6b0]">
          <a href="/docs/quickstart" class="hover:text-[#f7f8f8] transition">Quickstart</a>
          <a href="/docs/self-hosting-docker" class="hover:text-[#f7f8f8] transition">Self-Hosting</a>
          <a href="/docs/connectors" class="hover:text-[#f7f8f8] transition">Connectors</a>
          <a href="/docs/security-and-privacy" class="hover:text-[#f7f8f8] transition">Security</a>
          <a
            href="https://api.entrywise.si/reference"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#f7f8f8] transition inline-flex items-center gap-1"
          >
            <span>OpenAPI</span>
            <span class="text-[#686d76] text-[11px] font-mono">↗</span>
          </a>
        </nav>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href="https://app.entrywise.si"
          class="inline-flex items-center gap-1.5 text-[12px] font-medium text-[#08090a] bg-[#f7f8f8] hover:bg-white px-3 py-1 rounded-[6px] transition"
        >
          <span>Console</span>
          <span class="font-mono text-[11px]">→</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Mobile Navigation Bar -->
  <div class="lg:hidden border-b border-[#181a1f] bg-[#0d0e11] px-4 py-2.5 flex items-center justify-between">
    <span class="text-[12px] font-mono text-[#a1a6b0] truncate">{title}</span>
    <button
      type="button"
      id="mobileDocsMenuBtn"
      class="inline-flex items-center gap-1.5 text-[12px] text-[#f7f8f8] border border-[#22252b] bg-[#131519] px-2.5 py-1 rounded-[5px]"
    >
      <span>Index</span>
    </button>
  </div>

  <!-- Architectural Three-Column Documentation Frame -->
  <div class="max-w-[1380px] mx-auto grid grid-cols-1 lg:grid-cols-12 min-h-[calc(100vh-3.5rem)]">
    <!-- Left Navigation Rail -->
    <aside
      id="docsSidebar"
      class="hidden lg:block lg:col-span-3 xl:col-span-2 border-r border-[#181a1f] py-8 px-4 sm:px-6 sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto space-y-6 bg-[#08090a]"
    >
      <!-- Filter Input -->
      <div class="relative">
        <input
          type="search"
          id="docsSearchInput"
          placeholder="Filter guides…"
          class="w-full bg-[#0d0e11] border border-[#22252b] focus:border-[#f7f8f8]/40 rounded-[6px] pl-3 pr-7 py-1.5 text-[12px] text-[#f7f8f8] placeholder-[#686d76] focus:outline-none transition"
        />
        <kbd class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] font-mono text-[#686d76] pointer-events-none">/</kbd>
      </div>

      <!-- Overview Link -->
      <div>
        <a
          href="/docs"
          class={`block py-1.5 text-[13px] transition ${
            currentSlug === ''
              ? 'text-[#f7f8f8] font-medium'
              : 'text-[#8a8f98] hover:text-[#d0d6e0]'
          }`}
        >
          Overview
        </a>
      </div>

      <!-- Categorized Rail -->
      <div class="space-y-6" id="docsNavGroups">
        {
          groupedDocs.map((group) => (
            <div class="space-y-2 docs-nav-group">
              <div class="text-[11px] font-mono uppercase tracking-[0.08em] text-[#686d76]">
                {group.category}
              </div>
              <ul class="border-l border-[#181a1f] ml-0.5 space-y-0.5">
                {group.items.map((item) => {
                  const isActive = item.slug === currentSlug;
                  return (
                    <li
                      class="docs-nav-item"
                      data-title={item.title.toLowerCase()}
                      data-summary={item.summary.toLowerCase()}
                      data-category={item.category.toLowerCase()}
                    >
                      <a
                        href={`/docs/${item.slug}`}
                        class={`block -ml-[1px] pl-3.5 py-1.5 text-[13px] border-l transition-colors ${
                          isActive
                            ? 'border-[#f7f8f8] text-[#f7f8f8] font-medium'
                            : 'border-transparent text-[#8a8f98] hover:text-[#d0d6e0] hover:border-[#32363f]'
                        }`}
                      >
                        {item.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </aside>

    <!-- Main Prose Column -->
    <main class="lg:col-span-6 xl:col-span-7 py-10 px-6 sm:px-12 lg:px-16 min-w-0">
      <div class="max-w-[700px]">
        <slot />
      </div>
    </main>

    <!-- Right Table of Contents Rail -->
    <aside class="hidden lg:block lg:col-span-3 py-10 px-6 sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto border-l border-[#181a1f]">
      <div class="space-y-6">
        {
          sections.length > 0 && (
            <div class="space-y-2.5">
              <div class="text-[11px] font-mono uppercase tracking-[0.08em] text-[#686d76]">
                On this page
              </div>
              <ul class="space-y-1.5 border-l border-[#181a1f] ml-0.5">
                {sections.map((sec) => (
                  <li>
                    <a
                      href={`#${sec.id}`}
                      class="block -ml-[1px] pl-3 py-0.5 text-[12.5px] text-[#8a8f98] hover:text-[#f7f8f8] border-l border-transparent hover:border-[#32363f] transition-colors leading-snug"
                    >
                      {sec.heading}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="pt-6 border-t border-[#181a1f] space-y-2.5">
          <div class="text-[11px] font-mono uppercase tracking-[0.08em] text-[#686d76]">
            Resources
          </div>
          <ul class="space-y-2 text-[12.5px] text-[#8a8f98]">
            <li><a href="/privacy" class="hover:text-[#f7f8f8] transition">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-[#f7f8f8] transition">Terms of Service</a></li>
            <li>
              <a
                href="https://api.entrywise.si/reference"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-[#f7f8f8] transition flex items-center justify-between"
              >
                <span>OpenAPI 3.1 Spec</span>
                <span class="font-mono text-[11px] text-[#686d76]">↗</span>
              </a>
            </li>
            <li>
              <a
                href="https://github.com/vakhariaheet/entry-wise"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-[#f7f8f8] transition flex items-center justify-between"
              >
                <span>GitHub Repository</span>
                <span class="font-mono text-[11px] text-[#686d76]">↗</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </aside>
  </div>

  <script is:inline>
    const searchInput = document.getElementById('docsSearchInput');
    const navItems = document.querySelectorAll('.docs-nav-item');
    const navGroups = document.querySelectorAll('.docs-nav-group');

    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    searchInput?.addEventListener('input', (e) => {
      const q = (e.target.value || '').toLowerCase().trim();
      navItems.forEach((li) => {
        const title = li.getAttribute('data-title') || '';
        const summary = li.getAttribute('data-summary') || '';
        const category = li.getAttribute('data-category') || '';
        const match = !q || title.includes(q) || summary.includes(q) || category.includes(q);
        li.style.display = match ? '' : 'none';
      });

      navGroups.forEach((group) => {
        const visibleItems = Array.from(group.querySelectorAll('.docs-nav-item')).filter(
          (el) => el.style.display !== 'none'
        );
        group.style.display = visibleItems.length > 0 ? '' : 'none';
      });
    });

    const mobileBtn = document.getElementById('mobileDocsMenuBtn');
    const sidebar = document.getElementById('docsSidebar');
    mobileBtn?.addEventListener('click', () => {
      sidebar?.classList.toggle('hidden');
    });

    window.copyDocsCode = function (btn) {
      const wrapper = btn.closest('.docs-code-wrapper');
      const codeEl = wrapper?.querySelector('code');
      if (!codeEl) return;
      navigator.clipboard.writeText(codeEl.innerText);
      const original = btn.innerText;
      btn.innerText = 'Copied';
      setTimeout(() => {
        btn.innerText = original;
      }, 1600);
    };
  </script>
</body>
</html>
