---
import DocsLayout from '../../components/DocsLayout.astro';
import { getAllDocs, getDocBySlug } from '../../lib/emdashDocs';

const { slug = '' } = Astro.params;
const allDocs = await getAllDocs();
const doc = await getDocBySlug(slug);

if (!doc) {
  return Astro.redirect('/docs');
}

const currentIndex = allDocs.findIndex((item) => item.slug === doc.slug);
const prevDoc = currentIndex > 0 ? allDocs[currentIndex - 1] : null;
const nextDoc =
  currentIndex >= 0 && currentIndex < allDocs.length - 1 ? allDocs[currentIndex + 1] : null;

const calloutBorder = {
  info: 'border-l-[#70b8ff]',
  tip: 'border-l-[#3ad389]',
  warning: 'border-l-[#ffca16]',
  security: 'border-l-[#f7f8f8]',
};
---

<DocsLayout
  title={doc.title}
  description={doc.summary}
  allDocs={allDocs}
  currentSlug={doc.slug}
  sections={doc.sections}
  isFromCms={doc.isFromCms}
>
  <article {...doc.edit} class="space-y-10">
    <!-- Article Header -->
    <header class="space-y-3 pb-8 border-b border-[#181a1f]">
      <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono text-[#686d76]">
        <a href="/docs" class="hover:text-[#a1a6b0] transition">Docs</a>
        <span>/</span>
        <span {...doc.edit.category} class="text-[#a1a6b0]">{doc.category}</span>
        <span>·</span>
        <span {...doc.edit.reading_time} class="tabular-nums">{doc.readingTime}</span>
      </div>

      <h1
        {...doc.edit.title}
        class="text-[30px] sm:text-[34px] font-medium tracking-[-0.03em] text-[#f7f8f8] leading-[1.15]"
      >
        {doc.title}
      </h1>

      <p {...doc.edit.summary} class="text-[15px] text-[#a1a6b0] leading-[1.65]">
        {doc.summary}
      </p>
    </header>

    <!-- Optional CMS Body Markdown -->
    {
      doc.bodyMarkdown && (
        <div
          {...doc.edit.body_markdown}
          class="rounded-[8px] border border-[#22252b] bg-[#0d0e11] p-5 text-[14px] text-[#d0d6e0] whitespace-pre-wrap leading-[1.7]"
        >
          {doc.bodyMarkdown}
        </div>
      )
    }

    <!-- Structured Documentation Sections -->
    <div class="space-y-11">
      {
        doc.sections.map((sec) => (
          <section id={sec.id} class="scroll-mt-20 space-y-4">
            <h2 class="text-[19px] sm:text-[21px] font-medium text-[#f7f8f8] tracking-[-0.02em] flex items-center gap-2 group">
              <span>{sec.heading}</span>
              <a
                href={`#${sec.id}`}
                class="text-[#686d76] opacity-0 group-hover:opacity-100 hover:text-[#f7f8f8] transition text-sm font-mono"
                aria-label="Link to section"
              >
                #
              </a>
            </h2>

            {sec.paragraphs.map((p) => (
              <p class="text-[14.5px] text-[#d0d6e0] leading-[1.7] max-w-[65ch]">{p}</p>
            ))}

            {sec.bullets && sec.bullets.length > 0 && (
              <ul class="space-y-2 pt-1">
                {sec.bullets.map((bullet) => (
                  <li class="flex items-start gap-3 text-[14px] text-[#d0d6e0] leading-[1.65]">
                    <span class="text-[#686d76] font-mono text-xs mt-1 select-none">—</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}

            {sec.table && (
              <div class="overflow-x-auto rounded-[8px] border border-[#22252b] bg-[#0d0e11] my-4">
                <table class="w-full text-left border-collapse text-[12.5px]">
                  <thead>
                    <tr class="border-b border-[#181a1f] bg-[#08090a] text-[#8a8f98] font-mono text-[11px] uppercase tracking-[0.06em]">
                      {sec.table.headers.map((h) => (
                        <th class="py-2.5 px-4 font-medium">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-[#181a1f]">
                    {sec.table.rows.map((row) => (
                      <tr class="hover:bg-[#131519]/60 transition-colors">
                        <td class="py-2.5 px-4 font-mono text-[#f7f8f8] whitespace-nowrap">
                          {row.key}
                        </td>
                        {row.type !== undefined && (
                          <td class="py-2.5 px-4 font-mono text-[#8a8f98] whitespace-nowrap">
                            {row.type}
                          </td>
                        )}
                        {sec.table?.headers.length === 4 && (
                          <td class="py-2.5 px-4 font-mono text-[#686d76] whitespace-nowrap tabular-nums">
                            {row.defaultVal ?? '—'}
                          </td>
                        )}
                        <td class="py-2.5 px-4 text-[#a1a6b0] leading-[1.55]">{row.description}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {sec.codeExamples &&
              sec.codeExamples.map((example) => (
                <div class="rounded-[8px] border border-[#22252b] bg-[#0d0e11] overflow-hidden docs-code-wrapper my-4">
                  <div class="px-4 py-2 border-b border-[#181a1f] bg-[#08090a] flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                      <span class="text-[12px] font-medium text-[#d0d6e0]">{example.label}</span>
                      {example.filename && (
                        <span class="text-[11px] font-mono text-[#686d76]">
                          · {example.filename}
                        </span>
                      )}
                    </div>
                    <button
                      type="button"
                      onclick="copyDocsCode(this)"
                      class="text-[11px] font-mono text-[#a1a6b0] hover:text-[#f7f8f8] border border-[#22252b] hover:border-[#32363f] bg-[#0d0e11] px-2 py-0.5 rounded-[4px] transition cursor-pointer"
                    >
                      Copy
                    </button>
                  </div>
                  <pre class="p-4 text-[12.5px] font-mono text-[#d0d6e0] overflow-x-auto leading-[1.65]"><code>{example.code}</code></pre>
                </div>
              ))}

            {sec.callout && (
              <div
                class={`rounded-r-[6px] border border-[#22252b] border-l-2 bg-[#0d0e11] p-4 space-y-1 ${
                  calloutBorder[sec.callout.type] || calloutBorder.info
                }`}
              >
                <div class="text-[11px] font-mono uppercase tracking-[0.08em] text-[#f7f8f8]">
                  {sec.callout.title}
                </div>
                <p class="text-[13.5px] text-[#a1a6b0] leading-[1.6]">{sec.callout.body}</p>
              </div>
            )}
          </section>
        ))
      }
    </div>

    <!-- Previous / Next Navigation -->
    <nav class="pt-8 border-t border-[#181a1f] grid grid-cols-1 sm:grid-cols-2 gap-4">
      {
        prevDoc ? (
          <a
            href={`/docs/${prevDoc.slug}`}
            class="rounded-[6px] border border-[#22252b] hover:border-[#32363f] bg-[#0d0e11] p-4 transition group flex flex-col gap-1"
          >
            <span class="text-[11px] font-mono text-[#686d76]">← Previous</span>
            <span class="text-[14px] font-medium text-[#f7f8f8] group-hover:text-white transition">
              {prevDoc.title}
            </span>
          </a>
        ) : (
          <div />
        )
      }

      {
        nextDoc && (
          <a
            href={`/docs/${nextDoc.slug}`}
            class="rounded-[6px] border border-[#22252b] hover:border-[#32363f] bg-[#0d0e11] p-4 transition group flex flex-col items-end text-right gap-1"
          >
            <span class="text-[11px] font-mono text-[#686d76]">Next →</span>
            <span class="text-[14px] font-medium text-[#f7f8f8] group-hover:text-white transition">
              {nextDoc.title}
            </span>
          </a>
        )
      }
    </nav>
  </article>
</DocsLayout>
