---
import DocsLayout from '../../components/DocsLayout.astro';
import { getAllDocs, getDocBySlug } from '../../lib/emdashDocs';

const { slug = '' } = Astro.params;
const allDocs = await getAllDocs();
const doc = await getDocBySlug(slug);

if (!doc) {
  return Astro.redirect('/docs');
}

const currentIndex = allDocs.findIndex((item) => item.slug === doc.slug);
const prevDoc = currentIndex > 0 ? allDocs[currentIndex - 1] : null;
const nextDoc =
  currentIndex >= 0 && currentIndex < allDocs.length - 1 ? allDocs[currentIndex + 1] : null;

const calloutStyles = {
  info: 'border-sky-500/30 bg-sky-950/20 text-sky-200',
  tip: 'border-emerald-500/30 bg-emerald-950/20 text-emerald-200',
  warning: 'border-amber-500/30 bg-amber-950/20 text-amber-200',
  security: 'border-teal-500/30 bg-teal-950/20 text-teal-200',
};
---

<DocsLayout
  title={doc.title}
  description={doc.summary}
  allDocs={allDocs}
  currentSlug={doc.slug}
  sections={doc.sections}
  isFromCms={doc.isFromCms}
>
  <article {...doc.edit} class="space-y-8">
    <!-- Breadcrumb & Metadata Header -->
    <header class="space-y-4 border-b border-white/[0.08] pb-6">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
        <a href="/docs" class="text-zinc-500 hover:text-zinc-300 transition">Docs</a>
        <span class="text-zinc-600">/</span>
        <span {...doc.edit.category} class="text-emerald-400 font-semibold">{doc.category}</span>
        <span class="text-zinc-600">•</span>
        <span {...doc.edit.badge} class="text-zinc-300 bg-white/[0.05] border border-white/[0.09] px-2 py-0.5 rounded-full">
          {doc.badge}
        </span>
        <span class="text-zinc-600">•</span>
        <span {...doc.edit.reading_time} class="text-zinc-500">{doc.readingTime}</span>
      </div>

      <h1
        {...doc.edit.title}
        class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight"
      >
        {doc.title}
      </h1>

      <p {...doc.edit.summary} class="text-base text-zinc-400 leading-relaxed">
        {doc.summary}
      </p>
    </header>

    <!-- Custom Markdown Notes from EmDash CMS (if added by editor) -->
    {
      doc.bodyMarkdown && (
        <div
          {...doc.edit.body_markdown}
          class="docs-surface rounded-2xl p-5 border border-emerald-500/25 space-y-2 text-sm text-zinc-200 whitespace-pre-wrap leading-relaxed"
        >
          {doc.bodyMarkdown}
        </div>
      )
    }

    <!-- Structured Documentation Sections -->
    <div class="space-y-10">
      {
        doc.sections.map((sec) => (
          <section id={sec.id} class="scroll-mt-24 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2 group">
              <span>{sec.heading}</span>
              <a
                href={`#${sec.id}`}
                class="text-zinc-600 opacity-0 group-hover:opacity-100 hover:text-emerald-400 transition text-sm font-mono"
                aria-label="Link to section"
              >
                #
              </a>
            </h2>

            {sec.paragraphs.map((p) => (
              <p class="text-sm sm:text-[15px] text-zinc-300 leading-relaxed">{p}</p>
            ))}

            {sec.bullets && sec.bullets.length > 0 && (
              <ul class="space-y-2 pl-1">
                {sec.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-sm text-zinc-300 leading-relaxed">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mt-2 shrink-0" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}

            {sec.table && (
              <div class="overflow-x-auto rounded-xl border border-white/[0.08] bg-[#0a0c12]">
                <table class="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr class="border-b border-white/[0.08] bg-white/[0.03] text-zinc-300 font-mono">
                      {sec.table.headers.map((h) => (
                        <th class="py-3 px-4 font-semibold">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-white/[0.06]">
                    {sec.table.rows.map((row) => (
                      <tr class="hover:bg-white/[0.02] transition">
                        <td class="py-3 px-4 font-mono text-emerald-300 font-medium whitespace-nowrap">
                          {row.key}
                        </td>
                        {row.type !== undefined && (
                          <td class="py-3 px-4 font-mono text-zinc-300 whitespace-nowrap">
                            {row.type}
                          </td>
                        )}
                        {sec.table?.headers.length === 4 && (
                          <td class="py-3 px-4 font-mono text-zinc-400 whitespace-nowrap">
                            {row.defaultVal ?? '—'}
                          </td>
                        )}
                        <td class="py-3 px-4 text-zinc-300 leading-relaxed">{row.description}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {sec.codeExamples &&
              sec.codeExamples.map((example) => (
                <div class="docs-code-block rounded-2xl overflow-hidden docs-code-wrapper">
                  <div class="px-4 py-2.5 border-b border-white/[0.08] bg-white/[0.02] flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-emerald-400" />
                      <span class="text-xs font-semibold text-zinc-200">{example.label}</span>
                      {example.filename && (
                        <span class="text-[11px] font-mono text-zinc-500">
                          • {example.filename}
                        </span>
                      )}
                    </div>
                    <button
                      type="button"
                      onclick="copyDocsCode(this)"
                      class="text-[11px] font-mono text-zinc-400 hover:text-white bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] px-2.5 py-1 rounded-lg transition cursor-pointer"
                    >
                      Copy
                    </button>
                  </div>
                  <pre class="p-4 text-xs font-mono text-zinc-200 overflow-x-auto leading-relaxed"><code>{example.code}</code></pre>
                </div>
              ))}

            {sec.callout && (
              <div
                class={`rounded-xl border p-4 space-y-1.5 ${
                  calloutStyles[sec.callout.type] || calloutStyles.info
                }`}
              >
                <div class="text-xs font-bold uppercase tracking-wider font-mono">
                  {sec.callout.title}
                </div>
                <p class="text-xs sm:text-sm leading-relaxed opacity-90">{sec.callout.body}</p>
              </div>
            )}
          </section>
        ))
      }
    </div>

    <!-- Previous / Next Pagination -->
    <nav class="pt-8 border-t border-white/[0.08] grid grid-cols-1 sm:grid-cols-2 gap-4">
      {
        prevDoc ? (
          <a
            href={`/docs/${prevDoc.slug}`}
            class="docs-surface rounded-xl p-4 hover:border-emerald-500/40 transition group flex flex-col gap-1"
          >
            <span class="text-[11px] font-mono text-zinc-500">← Previous Guide</span>
            <span class="text-sm font-bold text-white group-hover:text-emerald-300 transition">
              {prevDoc.title}
            </span>
          </a>
        ) : (
          <div />
        )
      }

      {
        nextDoc && (
          <a
            href={`/docs/${nextDoc.slug}`}
            class="docs-surface rounded-xl p-4 hover:border-emerald-500/40 transition group flex flex-col items-end text-right gap-1"
          >
            <span class="text-[11px] font-mono text-zinc-500">Next Guide →</span>
            <span class="text-sm font-bold text-white group-hover:text-emerald-300 transition">
              {nextDoc.title}
            </span>
          </a>
        )
      }
    </nav>
  </article>
</DocsLayout>
