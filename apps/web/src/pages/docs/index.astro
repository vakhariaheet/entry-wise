---
import DocsLayout from '../../components/DocsLayout.astro';
import { DOC_CATEGORIES } from '../../data/defaultDocs';
import { getAllDocs } from '../../lib/emdashDocs';

const allDocs = await getAllDocs();
const isFromCms = allDocs.some((d) => d.isFromCms);

const groupedDocs = DOC_CATEGORIES.map((category) => ({
  category,
  items: allDocs.filter((doc) => doc.category === category),
})).filter((g) => g.items.length > 0);
---

<DocsLayout
  title="Documentation"
  description="Developer documentation for EntryWise: 30-second form quickstart, Magic HTML directives, Docker & Bun self-hosting, Zero-OAuth connectors, and GDPR security."
  allDocs={allDocs}
  currentSlug=""
  isFromCms={isFromCms}
>
  <div class="space-y-12">
    <!-- Clean Editorial Header (Zero Card Box) -->
    <header class="space-y-4 pb-8 border-b border-[#181a1f]">
      <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-[0.08em] text-[#686d76]">
        <span>Documentation</span>
        <span>·</span>
        <span>v0.2.0</span>
      </div>

      <h1 class="text-[32px] sm:text-[36px] font-medium tracking-[-0.03em] text-[#f7f8f8] leading-[1.15]">
        EntryWise Developer Guide
      </h1>

      <p class="text-[15px] text-[#a1a6b0] leading-[1.65] max-w-[62ch]">
        Ingest HTML and JSON forms at the edge in under 20ms, self-host with Docker and SQLite with zero Cloudflare lock-in, or route submissions directly into Airtable, Notion, and Google Sheets.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/docs/quickstart"
          class="inline-flex items-center gap-2 text-[13px] font-medium text-[#08090a] bg-[#f7f8f8] hover:bg-white px-3.5 py-2 rounded-[6px] transition"
        >
          <span>Quickstart</span>
          <span class="font-mono text-xs">→</span>
        </a>
        <a
          href="/docs/self-hosting-docker"
          class="inline-flex items-center gap-2 text-[13px] text-[#f7f8f8] bg-[#0d0e11] hover:bg-[#131519] border border-[#22252b] hover:border-[#32363f] px-3.5 py-2 rounded-[6px] transition"
        >
          <span>Docker Self-Hosting</span>
        </a>
        <a
          href="https://entrywise.si/reference"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-[13px] text-[#a1a6b0] hover:text-[#f7f8f8] px-2 py-2 transition"
        >
          <span>OpenAPI 3.1 Reference</span>
          <span class="font-mono text-xs text-[#686d76]">↗</span>
        </a>
      </div>
    </header>

    <!-- Drop-In Code Block -->
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-[13px] font-medium text-[#f7f8f8]">30-Second HTML Drop-In</h2>
        <span class="text-[11px] font-mono text-[#686d76]">&lt; 1.5KB embed.js</span>
      </div>

      <div class="rounded-[8px] border border-[#22252b] bg-[#0d0e11] overflow-hidden docs-code-wrapper">
        <div class="px-4 py-2 border-b border-[#181a1f] bg-[#08090a] flex items-center justify-between">
          <span class="text-[11.5px] font-mono text-[#8a8f98]">index.html</span>
          <button
            type="button"
            onclick="copyDocsCode(this)"
            class="text-[11px] font-mono text-[#a1a6b0] hover:text-[#f7f8f8] border border-[#22252b] hover:border-[#32363f] bg-[#0d0e11] px-2 py-0.5 rounded-[4px] transition cursor-pointer"
          >
            Copy
          </button>
        </div>
        <pre class="p-4 text-[12.5px] font-mono text-[#d0d6e0] overflow-x-auto leading-[1.65]"><code>{`<script src="https://entrywise.si/embed.js" defer></script>

<form class="entrywise-form" data-form-key="ew_live_your_form_key">
  <input type="email" name="email" placeholder="you@company.com" required />
  <textarea name="message" placeholder="How can we help?" required></textarea>
  <button type="submit">Send Message</button>
</form>`}</code></pre>
      </div>
    </section>

    <!-- Architectural Guide Directory (Flush Hairline Rows) -->
    <div class="space-y-10">
      {
        groupedDocs.map((group) => (
          <section class="space-y-3">
            <div class="flex items-center justify-between pb-2">
              <h2 class="text-[11px] font-mono uppercase tracking-[0.08em] text-[#686d76]">
                {group.category}
              </h2>
              <span class="text-[11px] font-mono text-[#686d76] tabular-nums">
                {group.items.length} {group.items.length === 1 ? 'guide' : 'guides'}
              </span>
            </div>

            <div class="border-t border-b border-[#181a1f] divide-y divide-[#181a1f]">
              {group.items.map((doc) => (
                <a
                  href={`/docs/${doc.slug}`}
                  {...doc.edit}
                  class="py-4 px-2 -mx-2 hover:bg-[#0d0e11] rounded-[6px] transition flex items-start justify-between gap-6 group"
                >
                  <div class="space-y-1 min-w-0">
                    <div class="flex items-center gap-2.5">
                      <h3
                        {...doc.edit.title}
                        class="text-[14.5px] font-medium text-[#f7f8f8] group-hover:text-white transition"
                      >
                        {doc.title}
                      </h3>
                      <span class="text-[11px] font-mono text-[#686d76]">{doc.badge}</span>
                    </div>
                    <p
                      {...doc.edit.summary}
                      class="text-[13px] text-[#8a8f98] leading-[1.55] line-clamp-2"
                    >
                      {doc.summary}
                    </p>
                  </div>

                  <div class="flex items-center gap-3 shrink-0 pt-0.5">
                    <span class="text-[11px] font-mono text-[#686d76] tabular-nums hidden sm:inline">
                      {doc.readingTime}
                    </span>
                    <span class="font-mono text-xs text-[#686d76] group-hover:text-[#f7f8f8] group-hover:translate-x-0.5 transition-all">
                      →
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</DocsLayout>
