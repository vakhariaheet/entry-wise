---
import { getLandingContent } from '../lib/emdashDocs';
import '../styles/global.css';

const { content: landing, edit: landingEdit } = await getLandingContent();
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#08090a" />
  <title>EntryWise: Headless Form Backend for Developers & AI Agents</title>
  <meta
    name="description"
    content="Sub-20ms headless form backend. Deploy on Cloudflare Workers & D1 or self-host anywhere with Docker & SQLite. Zero-OAuth connectors for Airtable, Notion, Google Sheets, Slack, and Discord."
  />
  <link rel="icon" type="image/png" href="/assets/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body class="bg-[#08090a] text-[#f7f8f8] min-h-screen antialiased selection:bg-white/15 selection:text-white">
  <!-- Sticky Top Navigation (56px, 1px architectural hairline) -->
  <header class="h-14 border-b border-[#181a1f] bg-[#08090a]/90 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-[1200px] mx-auto px-6 h-full flex items-center justify-between gap-4">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2.5 text-[#f7f8f8] hover:opacity-90 transition">
          <img
            src="/assets/logo.png"
            alt="EntryWise"
            class="w-5 h-5 rounded-[4px] border border-[#22252b]"
          />
          <span class="font-medium text-[13.5px] tracking-[-0.01em]">EntryWise</span>
          <span class="text-[#32363f] font-mono text-xs">/</span>
          <span class="text-[11.5px] font-mono text-[#686d76]">v0.2</span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-[13px] text-[#a1a6b0]">
          <a href="#architecture" class="hover:text-[#f7f8f8] transition">Architecture</a>
          <a href="#portability" class="hover:text-[#f7f8f8] transition">Self-Hosting</a>
          <a href="#specifications" class="hover:text-[#f7f8f8] transition">Specifications</a>
          <a href="/docs" class="hover:text-[#f7f8f8] transition">Docs</a>
          <a
            href="https://api.entrywise.si/reference"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#f7f8f8] transition inline-flex items-center gap-1"
          >
            <span>OpenAPI</span>
            <span class="font-mono text-[11px] text-[#686d76]">↗</span>
          </a>
        </nav>
      </div>

      <div class="flex items-center gap-2.5">
        <button
          type="button"
          onclick="copyUniversalPrompt()"
          class="hidden sm:inline-flex items-center gap-1.5 text-[12px] text-[#d0d6e0] hover:text-[#f7f8f8] bg-[#0d0e11] hover:bg-[#131519] border border-[#22252b] hover:border-[#32363f] px-3 py-1 rounded-[6px] transition cursor-pointer"
        >
          <span id="navPromptText">Copy Agent Prompt</span>
        </button>
        <a
          href="https://app.entrywise.si"
          class="inline-flex items-center gap-1.5 text-[12px] font-medium text-[#08090a] bg-[#f7f8f8] hover:bg-white px-3.5 py-1 rounded-[6px] transition"
        >
          <span>Console</span>
          <span class="font-mono text-[11px]">→</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Architectural Frame (1200px Structural Rail) -->
  <div class="max-w-[1200px] mx-auto border-x border-[#181a1f]">
    <!-- SECTION 1: SPLIT ARCHITECTURAL HERO -->
    <section
      {...landingEdit}
      class="grid grid-cols-1 lg:grid-cols-12 border-b border-[#181a1f]"
    >
      <!-- Left Column: Value Proposition & Proof -->
      <div class="lg:col-span-7 p-8 sm:p-12 lg:p-14 border-b lg:border-b-0 lg:border-r border-[#181a1f] flex flex-col justify-between">
        <div class="space-y-6">
          <!-- Quiet Release Marker -->
          <a
            href="/docs/self-hosting-docker"
            class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full text-[12px] border border-[#22252b] hover:border-[#32363f] bg-[#0d0e11] text-[#a1a6b0] hover:text-[#f7f8f8] transition w-fit"
          >
            <span {...landingEdit.badge_text} class="font-mono text-[11px] text-[#f7f8f8]">
              {landing.badgeText}
            </span>
            <span class="text-[#32363f]">·</span>
            <span {...landingEdit.badge_subtext} class="font-mono text-[11px] text-[#8a8f98]">
              {landing.badgeSubtext}
            </span>
            <span class="font-mono text-[11px] text-[#686d76]">→</span>
          </a>

          <!-- Authoritative Weight-500 Headline (Zero Gradient Slop) -->
          <h1 class="text-[36px] sm:text-[46px] lg:text-[50px] font-medium tracking-[-0.035em] text-[#f7f8f8] leading-[1.08]">
            <span {...landingEdit.headline_top}>{landing.headlineTop}</span>{' '}
            <span {...landingEdit.headline_gradient} class="text-[#8a8f98]">
              {landing.headlineGradient}
            </span>
          </h1>

          <!-- Subtitle -->
          <p
            {...landingEdit.subtitle}
            class="text-[15px] sm:text-[16px] text-[#a1a6b0] leading-[1.65] max-w-[54ch]"
          >
            {landing.subtitle}
          </p>

          <!-- Primary CTA Controls -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              {...landingEdit.primary_cta_label}
              href={landing.primaryCtaUrl}
              class="inline-flex items-center gap-2 text-[13px] font-medium text-[#08090a] bg-[#f7f8f8] hover:bg-white px-4 py-2.5 rounded-[6px] transition"
            >
              <span>{landing.primaryCtaLabel}</span>
              <span class="font-mono text-xs">→</span>
            </a>
            <a
              href="/docs"
              class="inline-flex items-center gap-2 text-[13px] font-medium text-[#f7f8f8] bg-[#0d0e11] hover:bg-[#131519] border border-[#22252b] hover:border-[#32363f] px-4 py-2.5 rounded-[6px] transition"
            >
              <span>Read Documentation</span>
            </a>
            <button
              type="button"
              onclick="copyUniversalPrompt()"
              class="inline-flex items-center gap-1.5 text-[12.5px] font-mono text-[#8a8f98] hover:text-[#f7f8f8] px-2.5 py-2 transition cursor-pointer"
            >
              <span id="heroCopyText">Copy AI Prompt</span>
            </button>
          </div>
        </div>

        <!-- Tabular Engineering Metrics -->
        <div class="grid grid-cols-3 gap-6 pt-10 mt-12 border-t border-[#181a1f]">
          <div>
            <div class="text-[20px] sm:text-[22px] font-medium text-[#f7f8f8] tracking-[-0.02em] tabular-nums">
              &lt; 15ms
            </div>
            <div class="text-[12px] text-[#686d76] mt-0.5">Edge P95 Ingestion</div>
          </div>
          <div>
            <div class="text-[20px] sm:text-[22px] font-medium text-[#f7f8f8] tracking-[-0.02em] tabular-nums">
              0 Lock-In
            </div>
            <div class="text-[12px] text-[#686d76] mt-0.5">Cloudflare or Docker</div>
          </div>
          <div>
            <div class="text-[20px] sm:text-[22px] font-medium text-[#f7f8f8] tracking-[-0.02em] tabular-nums">
              100/100
            </div>
            <div class="text-[12px] text-[#686d76] mt-0.5">OpenAPI 3.1 Spec</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Workbench & Live Edge Trace -->
      <div class="lg:col-span-5 bg-[#0b0c0f] flex flex-col justify-between">
        <div>
          <!-- Workbench Tab Bar -->
          <div class="h-11 border-b border-[#181a1f] px-4 flex items-center justify-between bg-[#08090a]">
            <div class="flex items-center gap-4 h-full text-[12px] font-mono">
              <button
                type="button"
                onclick="switchSdkTab('script')"
                id="tabScript"
                class="h-full border-b border-[#f7f8f8] text-[#f7f8f8] transition cursor-pointer"
              >
                embed.js
              </button>
              <button
                type="button"
                onclick="switchSdkTab('docker')"
                id="tabDocker"
                class="h-full border-b border-transparent text-[#686d76] hover:text-[#a1a6b0] transition cursor-pointer"
              >
                docker
              </button>
              <button
                type="button"
                onclick="switchSdkTab('nextjs')"
                id="tabNextjs"
                class="h-full border-b border-transparent text-[#686d76] hover:text-[#a1a6b0] transition cursor-pointer"
              >
                next.js
              </button>
              <button
                type="button"
                onclick="switchSdkTab('curl')"
                id="tabCurl"
                class="h-full border-b border-transparent text-[#686d76] hover:text-[#a1a6b0] transition cursor-pointer"
              >
                curl
              </button>
            </div>

            <button
              type="button"
              onclick="copySdkSnippet()"
              class="text-[11px] font-mono text-[#a1a6b0] hover:text-[#f7f8f8] border border-[#22252b] hover:border-[#32363f] bg-[#0d0e11] px-2 py-0.5 rounded-[4px] transition cursor-pointer"
            >
              <span id="sdkCopyLabel">Copy</span>
            </button>
          </div>

          <!-- Code Viewport -->
          <div class="p-5 font-mono text-[12px] leading-[1.65] text-[#d0d6e0] overflow-x-auto min-h-[250px]">
            <div id="contentScript">
              <pre><code><span class="text-[#686d76]">&lt;!-- 1. Drop-in &lt;1.5KB script --&gt;</span>
&lt;<span class="text-[#70b8ff]">script</span>
  <span class="text-[#a1a6b0]">src</span>=<span class="text-[#f7f8f8]">"https://api.entrywise.si/embed.js"</span>
  <span class="text-[#a1a6b0]">defer</span>
&gt;&lt;/<span class="text-[#70b8ff]">script</span>&gt;

<span class="text-[#686d76]">&lt;!-- 2. Bind any form with a single class --&gt;</span>
&lt;<span class="text-[#70b8ff]">form</span>
  <span class="text-[#a1a6b0]">class</span>=<span class="text-[#f7f8f8]">"entrywise-form"</span>
  <span class="text-[#a1a6b0]">data-form-key</span>=<span class="text-[#f7f8f8]">"ew_live_79a2f8c1"</span>
&gt;
  &lt;<span class="text-[#70b8ff]">input</span> <span class="text-[#a1a6b0]">type</span>=<span class="text-[#f7f8f8]">"email"</span> <span class="text-[#a1a6b0]">name</span>=<span class="text-[#f7f8f8]">"email"</span> <span class="text-[#a1a6b0]">required</span> /&gt;
  &lt;<span class="text-[#70b8ff]">textarea</span> <span class="text-[#a1a6b0]">name</span>=<span class="text-[#f7f8f8]">"message"</span> <span class="text-[#a1a6b0]">required</span>&gt;&lt;/<span class="text-[#70b8ff]">textarea</span>&gt;
  &lt;<span class="text-[#70b8ff]">button</span> <span class="text-[#a1a6b0]">type</span>=<span class="text-[#f7f8f8]">"submit"</span>&gt;Submit&lt;/<span class="text-[#70b8ff]">button</span>&gt;
&lt;/<span class="text-[#70b8ff]">form</span>&gt;</code></pre>
            </div>

            <div id="contentDocker" class="hidden">
              <pre><code><span class="text-[#686d76]"># Self-host anywhere with Docker &amp; SQLite WAL</span>
git clone https://github.com/vakhariaheet/entry-wise.git
cd entry-wise &amp;&amp; cp .env.example .env

<span class="text-[#686d76]"># Pluggable Queue ('memory' | 'http') &amp; Email</span>
QUEUE_DRIVER=memory \
DEFAULT_EMAIL_PROVIDER=resend \
RESEND_API_KEY=re_live_xxx \
docker compose up -d</code></pre>
            </div>

            <div id="contentNextjs" class="hidden">
              <pre><code><span class="text-[#686d76]">// app/actions/submitLead.ts</span>
<span class="text-[#70b8ff]">'use server'</span>;

<span class="text-[#70b8ff]">export async function</span> <span class="text-[#f7f8f8]">submitLead</span>(formData: FormData) &#123;
  <span class="text-[#70b8ff]">const</span> res = <span class="text-[#70b8ff]">await</span> fetch(
    <span class="text-[#f7f8f8]">`https://api.entrywise.si/f/$&#123;process.env.EW_KEY&#125;`</span>,
    &#123; method: <span class="text-[#f7f8f8]">'POST'</span>, body: formData &#125;
  );
  <span class="text-[#70b8ff]">return</span> res.json(); <span class="text-[#686d76]">// &#123; submission_id: "sub_..." &#125;</span>
&#125;</code></pre>
            </div>

            <div id="contentCurl" class="hidden">
              <pre><code>curl -X POST https://api.entrywise.si/f/ew_live_79a2 \
  -H <span class="text-[#f7f8f8]">"Content-Type: application/json"</span> \
  -d <span class="text-[#f7f8f8]">'&#123;
    "name": "Alex Rivera",
    "email": "alex@acme.dev",
    "_subject": "Enterprise Inquiry",
    "budget": "$25,000/yr"
  &#125;'</span></code></pre>
            </div>
          </div>
        </div>

        <!-- Interactive Live Edge Trace Inspector -->
        <div class="border-t border-[#181a1f] p-5 bg-[#08090a] space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 font-mono text-[11.5px]">
              <span class="text-[#70b8ff]">POST</span>
              <span class="text-[#a1a6b0]">/f/ew_live_79a2</span>
            </div>
            <button
              type="button"
              onclick="triggerPipelineDemo()"
              id="simDispatchBtn"
              class="text-[11px] font-mono text-[#f7f8f8] border border-[#22252b] hover:border-[#32363f] bg-[#0d0e11] hover:bg-[#131519] px-2.5 py-1 rounded-[4px] transition cursor-pointer"
            >
              Simulate Request →
            </button>
          </div>

          <div class="rounded-[6px] border border-[#181a1f] bg-[#0b0c0f] p-3 font-mono text-[11.5px] space-y-1.5 tabular-nums">
            <div class="flex items-center justify-between">
              <span class="text-[#3ad389]" id="traceStatus">201 Created</span>
              <span class="text-[#686d76]" id="traceLatency">11ms · FRA Edge</span>
            </div>
            <div class="text-[#a1a6b0] truncate" id="traceStep1">
              ├─ verify: Turnstile OK · RFC 7807 schema valid
            </div>
            <div class="text-[#a1a6b0] truncate" id="traceStep2">
              ├─ sqlite: committed record sub_91fa8c04
            </div>
            <div class="text-[#8a8f98] truncate" id="traceStep3">
              └─ queue: dispatched sheets, notion, slack
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: ARCHITECTURAL CAPABILITIES MATRIX (Flush 1px Hairline Grid) -->
    <section id="architecture" class="border-b border-[#181a1f]">
      <div class="p-8 sm:p-12 border-b border-[#181a1f] flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <div class="text-[11px] font-mono uppercase tracking-[0.08em] text-[#686d76]">
            01 / Architecture
          </div>
          <h2 class="text-[24px] sm:text-[28px] font-medium tracking-[-0.025em] text-[#f7f8f8] mt-2">
            Built like infrastructure, not a form builder
          </h2>
        </div>
        <p class="text-[13.5px] text-[#8a8f98] max-w-[46ch] leading-[1.6]">
          Every ingestion route validates payloads at the edge, commits synchronously to SQLite, and fans out to your downstream connectors asynchronously.
        </p>
      </div>

      <!-- Row 1 (3 Flush Architectural Cells) -->
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[#181a1f] border-b border-[#181a1f]">
        <div class="p-8 lg:p-10 space-y-3 hover:bg-[#0b0c0f] transition-colors flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-[11px] font-mono text-[#686d76]">
              <span>01</span>
              <span>&lt; 1.5KB GZIPPED</span>
            </div>
            <h3 class="text-[16px] font-medium text-[#f7f8f8] tracking-[-0.01em] pt-1">
              Class-Name Auto-Binder
            </h3>
            <p class="text-[13.5px] text-[#a1a6b0] leading-[1.6]">
              Load <code class="text-[#d0d6e0]">/embed.js</code> and add <code class="text-[#d0d6e0]">class="entrywise-form"</code> (or your own custom selector). Automatically handles AJAX submission, loading states, and inline confirmation without React boilerplate.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[#181a1f] font-mono text-[11.5px] text-[#686d76]">
            data-form-key="ew_live_*"
          </div>
        </div>

        <div class="p-8 lg:p-10 space-y-3 hover:bg-[#0b0c0f] transition-colors flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-[11px] font-mono text-[#686d76]">
              <span>02</span>
              <span>RFC 7807 ERRORS</span>
            </div>
            <h3 class="text-[16px] font-medium text-[#f7f8f8] tracking-[-0.01em] pt-1">
              Auto-Schema Discovery
            </h3>
            <p class="text-[13.5px] text-[#a1a6b0] leading-[1.6]">
              Start in flexible mode and EntryWise infers field types (<code class="text-[#d0d6e0]">email</code>, <code class="text-[#d0d6e0]">number</code>, <code class="text-[#d0d6e0]">boolean</code>, <code class="text-[#d0d6e0]">string</code>) on your first submission. Lock the schema in one click to enforce strict validation.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[#181a1f] font-mono text-[11.5px] text-[#686d76]">
            application/problem+json
          </div>
        </div>

        <div class="p-8 lg:p-10 space-y-3 hover:bg-[#0b0c0f] transition-colors flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-[11px] font-mono text-[#686d76]">
              <span>03</span>
              <span>ZERO OAUTH TOKENS</span>
            </div>
            <h3 class="text-[16px] font-medium text-[#f7f8f8] tracking-[-0.01em] pt-1">
              Direct Database &amp; Sheet Connectors
            </h3>
            <p class="text-[13.5px] text-[#a1a6b0] leading-[1.6]">
              Sync submissions directly to Airtable Bases, Notion Databases, and concurrency-safe Google Sheets (<code class="text-[#d0d6e0]">LockService</code> 30s mutex) without fragile OAuth refresh tokens.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[#181a1f] font-mono text-[11.5px] text-[#686d76]">
            5 native downstream targets
          </div>
        </div>
      </div>

      <!-- Row 2 (3 Flush Architectural Cells) -->
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[#181a1f]">
        <div class="p-8 lg:p-10 space-y-3 hover:bg-[#0b0c0f] transition-colors flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-[11px] font-mono text-[#686d76]">
              <span>04</span>
              <span>MULTI-PROVIDER</span>
            </div>
            <h3 class="text-[16px] font-medium text-[#f7f8f8] tracking-[-0.01em] pt-1">
              Pluggable Email Routing
            </h3>
            <p class="text-[13.5px] text-[#a1a6b0] leading-[1.6]">
              Dispatch team alerts and branded <code class="text-[#d0d6e0]">&#123;&#123;field&#125;&#125;</code> auto-responders through Cloudflare Send Email, Resend, SMTP2GO, MailerSend, or any custom HTTP mail webhook.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[#181a1f] font-mono text-[11.5px] text-[#686d76]">
            DEFAULT_EMAIL_PROVIDER=*
          </div>
        </div>

        <div class="p-8 lg:p-10 space-y-3 hover:bg-[#0b0c0f] transition-colors flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-[11px] font-mono text-[#686d76]">
              <span>05</span>
              <span>PRIVACY-FIRST</span>
            </div>
            <h3 class="text-[16px] font-medium text-[#f7f8f8] tracking-[-0.01em] pt-1">
              Turnstile, Spam Quarantine &amp; GDPR
            </h3>
            <p class="text-[13.5px] text-[#a1a6b0] leading-[1.6]">
              Verify Cloudflare Turnstile tokens at the edge, block disposable email domains, quarantine keyword spam for 1-click recovery, and enable Zero-IP storage mode for strict GDPR compliance.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[#181a1f] font-mono text-[11.5px] text-[#686d76]">
            store_ip: false (Zero-PII)
          </div>
        </div>

        <div class="p-8 lg:p-10 space-y-3 hover:bg-[#0b0c0f] transition-colors flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-[11px] font-mono text-[#686d76]">
              <span>06</span>
              <span>SANDBOX VERIFICATION</span>
            </div>
            <h3 class="text-[16px] font-medium text-[#f7f8f8] tracking-[-0.01em] pt-1">
              1-Click Pipeline Smoke Testing
            </h3>
            <p class="text-[13.5px] text-[#a1a6b0] leading-[1.6]">
              Append <code class="text-[#d0d6e0]">?mock=true</code> or trigger a smoke test from the Console to verify your entire D1/SQLite, webhook, and email pipeline. Purge all <code class="text-[#d0d6e0]">is_test=1</code> records in one click before launch.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[#181a1f] font-mono text-[11.5px] text-[#686d76]">
            POST /f/:key?mock=true
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: DUAL DEPLOYMENT PORTABILITY (Cloudflare Edge vs Docker) -->
    <section id="portability" class="border-b border-[#181a1f]">
      <div class="p-8 sm:p-12 border-b border-[#181a1f] flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <div class="text-[11px] font-mono uppercase tracking-[0.08em] text-[#686d76]">
            02 / Runtime Portability
          </div>
