---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EntryWise — Headless Form Backend for Developers & AI Agents</title>
    <meta name="description" content="Sub-20ms edge form backend powered by Cloudflare Workers. D1 SQLite storage, Turnstile bot protection, battle-tested Google Sheets sync, HMAC webhooks, and 1-click AI prompts.">
    <link rel="icon" type="image/png" href="/assets/logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        .hero-glow {
            background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(16, 185, 129, 0.18) 0%, rgba(16, 185, 129, 0.03) 50%, transparent 80%);
        }
        .mesh-grid {
            background-image: linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
            background-size: 32px 32px;
            mask-image: radial-gradient(ellipse 70% 60% at 50% 10%, #000 70%, transparent 100%);
        }
        .card-surface {
            background: #0d0f17;
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .card-surface:hover {
            border-color: rgba(255, 255, 255, 0.16);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.6);
        }
        .step-pulse {
            animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse-ring {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }
    </style>
</head>
<body class="bg-[#07080b] text-[#f4f4f5] min-h-screen relative overflow-x-hidden selection:bg-emerald-500/20 selection:text-emerald-300">
    <!-- Ambient Hero Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[700px] hero-glow pointer-events-none -z-10"></div>
    <div class="absolute inset-0 mesh-grid pointer-events-none -z-10"></div>

    <!-- Navigation Bar -->
    <header class="border-b border-white/[0.08] bg-[#07080b]/80 backdrop-blur-xl sticky top-0 z-50 transition-all">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-8">
                <!-- Brand -->
                <a href="/" class="flex items-center gap-3 group">
                    <img src="/assets/logo.png" alt="EntryWise" class="w-8 h-8 rounded-lg border border-white/[0.12] shadow-sm group-hover:scale-105 transition-transform" />
                    <span class="font-bold text-base tracking-tight text-white">EntryWise</span>
                    <span class="text-[11px] font-mono text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/25 bg-emerald-500/10">v0.2.0</span>
                </a>

                <!-- Desktop Nav Links -->
                <nav class="hidden md:flex items-center gap-6 text-[13px] text-zinc-400 font-medium">
                    <a href="#pipeline" class="hover:text-white transition">Pipeline Flow</a>
                    <a href="#sdk" class="hover:text-white transition">SDKs &amp; Prompts</a>
                    <a href="#integrations" class="hover:text-white transition">Integrations</a>
                    <a href="#benchmarks" class="hover:text-white transition">Benchmarks</a>
                    <a href="#sandbox" class="hover:text-white transition">Live Sandbox</a>
                    <a href="/docs" class="hover:text-white transition flex items-center gap-1">
                        <span>OpenAPI</span>
                        <span class="text-[10px] font-mono text-zinc-500 bg-white/5 px-1 py-0.5 rounded">100/100 A+</span>
                    </a>
                </nav>
            </div>

            <!-- Header CTAs -->
            <div class="flex items-center gap-3">
                <button onclick="copyUniversalPrompt()" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-zinc-300 hover:text-white bg-white/[0.05] hover:bg-white/[0.08] border border-white/[0.1] px-3.5 py-1.5 rounded-lg transition shadow-sm">
                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    <span id="navPromptText">Copy AI Prompt</span>
                </button>
                <a href="https://entrywise-app.pages.dev" class="inline-flex items-center gap-1.5 text-xs font-semibold text-black bg-white hover:bg-zinc-200 px-4 py-2 rounded-lg transition shadow-md shadow-white/5">
                    <span>Open Console</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="pt-20 pb-16 px-6 max-w-5xl mx-auto text-center space-y-8">
        <!-- Top Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-medium border border-emerald-500/30 bg-emerald-950/30 text-emerald-300 shadow-inner">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Sub-20ms Headless Form Ingestion</span>
            <span class="text-zinc-600">•</span>
            <span class="text-zinc-300 font-mono">Cloudflare Workers + D1 SQLite</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-[1.08]">
            The form backend built for <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-100 to-zinc-300">modern developers &amp; AI.</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-zinc-400 max-w-2xl mx-auto font-normal leading-relaxed">
            Drop an endpoint into React, Next.js Server Actions, or native HTML forms. With instant D1 SQLite persistence, Turnstile bot trapping, dynamic Google Sheets sync, and signed webhooks.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <a href="https://entrywise-app.pages.dev" class="inline-flex items-center gap-2 text-sm font-semibold text-black bg-white hover:bg-zinc-200 px-6 py-3.5 rounded-xl transition shadow-xl shadow-white/10 group">
                <span>Start Free in Console</span>
                <svg class="w-4 h-4 text-black group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <button onclick="copyUniversalPrompt()" class="inline-flex items-center gap-2 text-sm font-medium text-zinc-200 hover:text-white bg-white/[0.05] hover:bg-white/[0.09] border border-white/[0.12] px-6 py-3.5 rounded-xl transition shadow-sm">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <span id="heroCopyText">Copy Universal Prompt for Cursor</span>
            </button>
            <a href="#pipeline" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-400 hover:text-zinc-200 px-4 py-3.5 transition">
                <span>Watch Pipeline Demo</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>
        </div>
    </section>

    <!-- SECTION 1: LIVE INTERACTIVE PIPELINE FLOW (Hero Feature) -->
    <section id="pipeline" class="py-16 px-6 max-w-7xl mx-auto border-t border-white/[0.08]">
        <div class="text-center space-y-3 mb-12">
            <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400 font-mono">Real-Time Ingestion</span>
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">Watch a submission route to all destinations</h2>
            <p class="text-sm text-zinc-400 max-w-xl mx-auto">
                Type a test message and hit dispatch. See how EntryWise processes edge ingestion, database commits, spreadsheet sync, and team alerts in parallel.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left: Client Form Simulator (4 cols) -->
            <div class="lg:col-span-5 card-surface rounded-2xl p-6 space-y-5">
                <div class="flex items-center justify-between pb-3 border-b border-white/[0.08]">
                    <div class="flex items-center gap-2">
                        <div class="w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
                        <span class="text-xs font-semibold text-white tracking-wide">Client Form Ingestion</span>
                    </div>
                    <span class="text-[11px] font-mono text-zinc-500">POST /f/ew_live_79a2</span>
                </div>

                <div class="space-y-3.5">
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Submitter Name</label>
                        <input type="text" id="simName" value="Alex Rivera" class="w-full bg-[#07080b] border border-white/[0.1] rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500/50 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Work Email</label>
                        <input type="email" id="simEmail" value="alex@acme-corp.com" class="w-full bg-[#07080b] border border-white/[0.1] rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500/50 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Inquiry / Message</label>
                        <input type="text" id="simMessage" value="Evaluating EntryWise edge form backend for our Next.js 15 migration." class="w-full bg-[#07080b] border border-white/[0.1] rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500/50 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Dynamic Field (Auto-expands Google Sheet!)</label>
                        <input type="text" id="simBudget" value="$25,000 / year" class="w-full bg-[#07080b] border border-white/[0.1] rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500/50 transition">
                    </div>
                </div>

                <button type="button" onclick="triggerPipelineDemo()" id="simDispatchBtn" class="w-full py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black text-xs font-bold transition flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/20 active:scale-[0.98]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    <span>Dispatch Submission Now</span>
                </button>
            </div>

            <!-- Right: Live Pipeline Multi-Destination Execution (7 cols) -->
            <div class="lg:col-span-7 card-surface rounded-2xl p-6 space-y-6">
                <div class="flex items-center justify-between pb-3 border-b border-white/[0.08]">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span class="text-xs font-semibold text-white tracking-wide">Parallel Delivery Pipeline</span>
                    </div>
                    <span id="pipelineStatus" class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">Ready for dispatch</span>
                </div>

                <!-- Pipeline Stages -->
                <div class="space-y-3">
                    <!-- Stage 1: Cloudflare Edge Router -->
                    <div class="p-3.5 rounded-xl border border-white/[0.08] bg-[#07080b] flex items-center justify-between transition" id="stageEdge">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/25 flex items-center justify-center text-emerald-400 font-mono text-xs font-bold">1</div>
                            <div>
                                <div class="text-xs font-semibold text-white flex items-center gap-2">
                                    <span>Cloudflare Workers Edge Router</span>
                                    <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-white/5 text-zinc-400">PoP: SFO</span>
                                </div>
                                <div class="text-[11px] text-zinc-400 mt-0.5">Turnstile bot verified • Rate limits cleared • RFC 7807 schema validated</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-mono font-bold text-emerald-400" id="stageEdgeLatency">11ms</span>
                            <div class="text-[10px] font-mono text-zinc-500">201 Created</div>
                        </div>
                    </div>

                    <!-- Stage 2: Cloudflare D1 SQLite -->
                    <div class="p-3.5 rounded-xl border border-white/[0.08] bg-[#07080b] flex items-center justify-between transition" id="stageD1">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-teal-500/10 border border-teal-500/25 flex items-center justify-center text-teal-400 font-mono text-xs font-bold">2</div>
                            <div>
                                <div class="text-xs font-semibold text-white">D1 SQLite Distributed Ledger</div>
                                <div class="text-[11px] text-zinc-400 mt-0.5" id="stageD1SubId">Record committed: sub_91fa8...</div>
                            </div>
                        </div>
                        <span class="text-[11px] font-mono text-teal-400 bg-teal-500/10 px-2 py-0.5 rounded border border-teal-500/20">Stored</span>
                    </div>

                    <!-- Stage 3: Integrations Fanout -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                        <!-- Google Sheets -->
                        <div class="p-3.5 rounded-xl border border-white/[0.08] bg-[#07080b] space-y-2 transition" id="stageSheets">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-semibold text-white">Google Sheets</span>
                                <span class="w-2 h-2 rounded-full bg-emerald-400" id="dotSheets"></span>
                            </div>
                            <div class="text-[10px] text-zinc-400 leading-tight">30s LockService acquired. Auto-appended dynamic <code class="text-emerald-400">budget</code> column.</div>
                        </div>

                        <!-- Slack Alert -->
                        <div class="p-3.5 rounded-xl border border-white/[0.08] bg-[#07080b] space-y-2 transition" id="stageSlack">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-semibold text-white">Slack Alert</span>
                                <span class="w-2 h-2 rounded-full bg-amber-400" id="dotSlack"></span>
                            </div>
                            <div class="text-[10px] text-zinc-400 leading-tight">Block card dispatched to <span class="text-zinc-200">#sales-leads</span> with instant one-click view.</div>
                        </div>

                        <!-- Auto-Responder -->
                        <div class="p-3.5 rounded-xl border border-white/[0.08] bg-[#07080b] space-y-2 transition" id="stageEmail">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-semibold text-white">Branded Email</span>
                                <span class="w-2 h-2 rounded-full bg-blue-400" id="dotEmail"></span>
                            </div>
                            <div class="text-[10px] text-zinc-400 leading-tight">Confirmation sent to submitter with custom HTML template &amp; variables.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 2: INTERACTIVE CODE & SDK SANDBOX -->
    <section id="sdk" class="py-20 px-6 max-w-5xl mx-auto border-t border-white/[0.08]">
        <div class="text-center space-y-3 mb-12">
            <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400 font-mono">Developer Experience</span>
            <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">One endpoint. Zero boilerplate.</h2>
            <p class="text-sm sm:text-base text-zinc-400 max-w-xl mx-auto">
                Paste the Universal Prompt into your AI editor, or copy production-ready code for your favorite frontend framework.
            </p>
        </div>

        <div class="card-surface rounded-2xl shadow-2xl overflow-hidden">
            <!-- Terminal Header -->
            <div class="px-5 py-3.5 border-b border-white/[0.08] bg-[#090a0f] flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-1.5">
                        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                    </div>
                    <!-- Framework Tabs -->
                    <div class="flex items-center bg-[#141721] p-0.5 rounded-lg border border-white/[0.08] text-xs font-medium text-zinc-400">
                        <button type="button" onclick="switchSdkTab('prompt')" id="tabPrompt" class="px-3 py-1.5 rounded-md text-white bg-zinc-800 transition font-medium">Universal AI Prompt</button>
                        <button type="button" onclick="switchSdkTab('nextjs')" id="tabNextjs" class="px-3 py-1.5 rounded-md hover:text-white transition">Next.js 15 Action</button>
                        <button type="button" onclick="switchSdkTab('react')" id="tabReact" class="px-3 py-1.5 rounded-md hover:text-white transition">React 19 Hook</button>
                        <button type="button" onclick="switchSdkTab('html')" id="tabHtml" class="px-3 py-1.5 rounded-md hover:text-white transition">Zero-JS HTML</button>
                        <button type="button" onclick="switchSdkTab('curl')" id="tabCurl" class="px-3 py-1.5 rounded-md hover:text-white transition">cURL</button>
                    </div>
                </div>

                <button type="button" onclick="copySdkSnippet()" class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-300 hover:text-white bg-white/[0.06] hover:bg-white/[0.1] border border-white/[0.1] px-3.5 py-1.5 rounded-lg transition shadow-sm">
                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    <span id="sdkCopyLabel">Copy Snippet</span>
                </button>
            </div>

            <!-- Terminal Snippet Body -->
            <div class="p-6 bg-[#07080b] font-mono text-xs leading-relaxed overflow-x-auto min-h-[300px]">
                <!-- Tab: Universal AI Prompt -->
                <div id="contentPrompt" class="space-y-2 text-zinc-300">
                    <div class="text-zinc-500 mb-2"># Paste directly into Cursor Composer, Claude Code, v0, or ChatGPT:</div>
                    <p class="text-emerald-400 font-semibold">Integrate EntryWise (v0.2.0) into this project as the headless form backend.</p>
                    <p class="text-zinc-400 pt-2 font-bold">### Target Endpoint:</p>
                    <p class="text-zinc-300">- URL: <span class="text-amber-300">POST https://entrywise.webbound.in/f/YOUR_SITE_API_KEY</span></p>
                    <p class="text-zinc-300">- Headers: <span class="text-amber-300">Content-Type: application/json</span> (or multipart/form-data for file uploads)</p>
                    <p class="text-zinc-400 pt-2 font-bold">### Implementation Rules:</p>
                    <p class="text-zinc-300">1. Honeypot Bot Trap: Add &lt;input name="_gotcha" style="display:none" tabIndex="-1" autoComplete="off" /&gt;</p>
                    <p class="text-zinc-300">2. Cloudflare Turnstile: If using bot protection, include &lt;input type="hidden" name="cf-turnstile-response" /&gt;</p>
                    <p class="text-zinc-300">3. Status Handling: Expect HTTP 201 Created on success. On failure, parse RFC 7807 problem details response JSON.</p>
                </div>

                <!-- Tab: Next.js 15 Server Action -->
                <div id="contentNextjs" class="hidden text-zinc-300">
<pre><code><span class="text-zinc-500">// app/actions/submitForm.ts</span>
<span class="text-purple-400">'use server'</span>;

<span class="text-purple-400">export async function</span> <span class="text-blue-400">submitContactForm</span>(prevState: <span class="text-teal-400">any</span>, formData: <span class="text-teal-400">FormData</span>) &#123;
  <span class="text-purple-400">const</span> apiKey = process.env.<span class="text-amber-300">ENTRYWISE_API_KEY</span>!;
  
  <span class="text-purple-400">const</span> response = <span class="text-purple-400">await</span> <span class="text-blue-400">fetch</span>(<span class="text-amber-300">`https://entrywise.webbound.in/f/$&#123;apiKey&#125;`</span>, &#123;
    method: <span class="text-amber-300">'POST'</span>,
    body: formData,
  &#125;);

  <span class="text-purple-400">if</span> (!response.ok) &#123;
    <span class="text-purple-400">const</span> error = <span class="text-purple-400">await</span> response.<span class="text-blue-400">json</span>();
    <span class="text-purple-400">return</span> &#123; success: <span class="text-red-400">false</span>, message: error.title || <span class="text-amber-300">'Submission failed'</span> &#125;;
  &#125;

  <span class="text-purple-400">const</span> data = <span class="text-purple-400">await</span> response.<span class="text-blue-400">json</span>();
  <span class="text-purple-400">return</span> &#123; success: <span class="text-emerald-400">true</span>, submissionId: data.submission_id &#125;;
&#125;</code></pre>
                </div>

                <!-- Tab: React 19 Client Component -->
                <div id="contentReact" class="hidden text-zinc-300">
<pre><code><span class="text-purple-400">import</span> &#123; useState &#125; <span class="text-purple-400">from</span> <span class="text-amber-300">'react'</span>;

<span class="text-purple-400">export function</span> <span class="text-blue-400">ContactForm</span>() &#123;
  <span class="text-purple-400">const</span> [isSubmitting, setIsSubmitting] = <span class="text-blue-400">useState</span>(<span class="text-red-400">false</span>);
  <span class="text-purple-400">const</span> [submitted, setSubmitted] = <span class="text-blue-400">useState</span>(<span class="text-red-400">false</span>);

  <span class="text-purple-400">async function</span> <span class="text-blue-400">handleSubmit</span>(e: <span class="text-teal-400">React.FormEvent&lt;HTMLFormElement&gt;</span>) &#123;
    e.<span class="text-blue-400">preventDefault</span>();
    setIsSubmitting(<span class="text-emerald-400">true</span>);

    <span class="text-purple-400">const</span> payload = Object.<span class="text-blue-400">fromEntries</span>(<span class="text-purple-400">new</span> <span class="text-teal-400">FormData</span>(e.currentTarget));
