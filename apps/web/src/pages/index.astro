  <script is:inline>
    const UNIVERSAL_PROMPT = `Integrate EntryWise (v0.2.0) into this project as the headless form backend.

### Option A: Zero-JS Drop-In Class Binder
<script src="https://api.entrywise.si/embed.js" defer><\/script>
<form class="entrywise-form" data-form-key="YOUR_SITE_API_KEY">
  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
  <input type="email" name="email" required />
  <textarea name="message" required></textarea>
  <button type="submit">Send</button>
</form>

### Option B: Direct JSON / FormData POST
- Endpoint: POST https://api.entrywise.si/f/YOUR_SITE_API_KEY
- Magic Directives: _gotcha (honeypot), _subject, _replyto, _cc, _redirect, ?mock=true
- Status: 201 Created on success; RFC 7807 problem+json on validation error.`;

    window.copyUniversalPrompt = function () {
      navigator.clipboard.writeText(UNIVERSAL_PROMPT);
      const navText = document.getElementById('navPromptText');
      const heroText = document.getElementById('heroCopyText');
      if (navText) navText.innerText = 'Copied Prompt';
      if (heroText) heroText.innerText = 'Copied Prompt';
      setTimeout(() => {
        if (navText) navText.innerText = 'Copy Agent Prompt';
        if (heroText) heroText.innerText = 'Copy AI Prompt';
      }, 1800);
    };

    const SDK_TABS = ['script', 'docker', 'nextjs', 'curl'];
    window.switchSdkTab = function (tab) {
      SDK_TABS.forEach((t) => {
        const cap = t.charAt(0).toUpperCase() + t.slice(1);
        const btn = document.getElementById('tab' + cap);
        const panel = document.getElementById('content' + cap);
        if (t === tab) {
          btn?.classList.add('border-[#f7f8f8]', 'text-[#f7f8f8]');
          btn?.classList.remove('border-transparent', 'text-[#686d76]');
          panel?.classList.remove('hidden');
        } else {
          btn?.classList.remove('border-[#f7f8f8]', 'text-[#f7f8f8]');
          btn?.classList.add('border-transparent', 'text-[#686d76]');
          panel?.classList.add('hidden');
        }
      });
    };

    window.copySdkSnippet = function () {
      const visible = SDK_TABS.map((t) =>
        document.getElementById('content' + t.charAt(0).toUpperCase() + t.slice(1))
      ).find((el) => el && !el.classList.contains('hidden'));
      if (!visible) return;
      navigator.clipboard.writeText(visible.innerText);
      const label = document.getElementById('sdkCopyLabel');
      if (label) {
        label.innerText = 'Copied';
        setTimeout(() => {
          label.innerText = 'Copy';
        }, 1600);
      }
    };

    window.triggerPipelineDemo = function () {
      const btn = document.getElementById('simDispatchBtn');
      const status = document.getElementById('traceStatus');
      const latency = document.getElementById('traceLatency');
      const step2 = document.getElementById('traceStep2');
      if (!btn || !status || !latency || !step2) return;

      btn.innerText = 'Dispatching…';
      status.innerText = 'Processing…';
      const ms = Math.floor(Math.random() * 6) + 9;
      const id = 'sub_' + Math.random().toString(16).slice(2, 10);

      setTimeout(() => {
        status.innerText = '201 Created';
        latency.innerText = ms + 'ms · Edge PoP';
        step2.innerText = '├─ sqlite: committed record ' + id;
        btn.innerText = 'Simulate Request →';
      }, 220);
    };
  </script>
