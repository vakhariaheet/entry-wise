# ==============================================================================
# EntryWise Self-Hosted Configuration (.env.example)
# Deploy anywhere via Docker Compose, Railway, Fly.io, Coolify, Render, or VPS.
# Zero Cloudflare lock-in required.
# ==============================================================================

PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/entrywise.sqlite
UPLOAD_DIR=./data/uploads

# ------------------------------------------------------------------------------
# 1. Security Secrets (Generate with: openssl rand -hex 32)
# ------------------------------------------------------------------------------
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=replace-with-a-strong-random-jwt-secret-at-least-32-characters

# ------------------------------------------------------------------------------
# 2. Pluggable Queue Engine (No Cloudflare Queues Required)
#    Options:
#      - memory : Fast in-process background queue with automatic retries (Default)
#      - http   : Forward queue jobs to an external HTTP Queue (Upstash QStash, BullMQ, n8n)
# ------------------------------------------------------------------------------
QUEUE_DRIVER=memory
QUEUE_MAX_RETRIES=3
# QUEUE_WEBHOOK_URL=https://qstash.upstash.io/v2/publish/https://your-worker.example.com/process
# QUEUE_WEBHOOK_TOKEN=your_qstash_or_webhook_bearer_token

# ------------------------------------------------------------------------------
# 3. Pluggable Default Email Engine (No Cloudflare Email Required)
#    Options:
#      - resend     : Resend API (set RESEND_API_KEY)
#      - smtp2go    : SMTP2GO API (set SMTP2GO_API_KEY)
#      - mailersend : MailerSend API (set MAILERSEND_API_KEY)
#      - mailtrap   : Mailtrap API (set MAILTRAP_API_KEY)
#      - webhook    : Custom HTTP Email Bridge / n8n / Zapier (set EMAIL_WEBHOOK_URL)
#      - console    : Logs emails to stdout for local testing (Default when no key is set)
# ------------------------------------------------------------------------------
DEFAULT_EMAIL_PROVIDER=resend
DEFAULT_FROM_EMAIL=notifications@yourdomain.com
DEFAULT_FROM_NAME=EntryWise Forms

RESEND_API_KEY=
SMTP2GO_API_KEY=
MAILERSEND_API_KEY=
MAILTRAP_API_KEY=
EMAIL_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. Optional CORS & Authentication
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4321
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
