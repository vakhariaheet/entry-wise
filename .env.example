# =============================================================================
# EntryWise Configuration Template
# =============================================================================

# Server Network Settings
PORT=8787
HOST=0.0.0.0
BASE_URL=http://localhost:8787

# Security & Cryptography Secrets
# Generate random 32-character strings for these:
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters
ADMIN_SECRET=replace_with_a_secure_random_admin_secret_string
ENCRYPTION_KEY=replace_with_a_32_character_hex_encryption_key_0123456789abcdef

# Database Driver Configuration
# Options: 'sqlite' (self-hosted default) | 'postgres' | 'd1' (managed Cloudflare)
DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/entrywise.db
# DATABASE_URL=postgres://user:password@localhost:5432/entrywise

# Storage Driver Configuration
# Options: 'local' (self-hosted default) | 's3' | 'r2' (managed Cloudflare)
STORAGE_DRIVER=local
STORAGE_PATH=./uploads
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=entrywise-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Queue & Asynchronous Processing Driver
# Options: 'memory' (in-memory async) | 'redis' | 'cloudflare-queues' (managed)
QUEUE_DRIVER=memory
# REDIS_URL=redis://localhost:6379

# Email Delivery Providers
# Standard SMTP or Resend
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com

# Authentication (Optional Clerk SSO or Built-in TOTP)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Bot Protection (Cloudflare Turnstile)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
